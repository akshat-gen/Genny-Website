# Copy to server/.env.local for local development; set the same keys in
# Vercel → Project → Settings → Environment Variables for deploys.
PORT=4000

# Microsoft 365 mailbox the emails are sent from (also the From address)
MAIL_FROM=
# Entra app registration used to send via Microsoft Graph (Mail.Send)
MS_TENANT_ID=
MS_CLIENT_ID=
# Client secret value (never commit the real value)
MS_CLIENT_SECRET=
# Comma-separated recipients of the internal "New demo request" alert
DEMO_INTERNAL_TO=
# Optional marketing inbox: BCC'd on, and the Reply-To of, the visitor's welcome email.
# Leave empty to send no BCC and have replies go to MAIL_FROM.
DEMO_MARKETING_EMAIL=
